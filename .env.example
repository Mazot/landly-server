FRONTEND_ORIGIN=http://localhost:8080

# docker-compose service credentials — required, there are no defaults.
# Use long random values; never reuse these placeholders outside local dev.
# Postgres/Redis passwords are embedded in DATABASE_URL/REDIS_URL, so keep
# them URL-safe and without whitespace, e.g. `openssl rand -hex 32`.
POSTGRES_USER=landly-user
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=landly
REDIS_USER=redis
REDIS_PASSWORD=change-me-redis
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password
# Host interface for the db/redis/minio ports (loopback unless you really
# need them reachable from other machines).
SERVICES_BIND_ADDRESS=127.0.0.1

DATABASE_URL=postgres://landly-user:change-me-postgres@localhost:5432/landly
REDIS_URL=redis://redis:change-me-redis@localhost:6379/
GOOGLE_CLIENT_ID=google-client-id
GOOGLE_CLIENT_SECRET=google-client-secret
OAUTH_GOOGLE_REDIRECT_URL=http://localhost:8080/api/user/oauth/google/callback
JWT_SECRET=0987654321
# true only behind a reverse proxy that overwrites X-Forwarded-For (rate limiting)
TRUST_PROXY_HEADERS=false

# Object Storage (MinIO for local dev; S3 or Cloudflare R2 for production)
# Run MinIO locally: docker compose -f docker/docker-compose-minio.yml up -d
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=change-me-minio-user
S3_SECRET_ACCESS_KEY=change-me-minio-password
S3_BUCKET=landly-images
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/landly-images

# Redis Connection Pool Configuration
REDIS_POOL_MAX_SIZE=10
REDIS_POOL_MIN_IDLE=2
REDIS_POOL_MAX_LIFETIME_SECS=1800
REDIS_POOL_IDLE_TIMEOUT_SECS=600
REDIS_POOL_CONNECTION_TIMEOUT_SECS=30

# Database Connection Pool Configuration
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_MAX_LIFETIME_SECS=1800
DB_POOL_IDLE_TIMEOUT_SECS=600
DB_POOL_CONNECTION_TIMEOUT_SECS=30
# Read-only role for the Postgres MCP server — generated by scripts/dev/setup-readonly-db.sh
# MCP_DATABASE_URL=postgresql://landly_readonly:<generated>@localhost:5432/landly
# MCP_REDIS_URL=redis://landly_readonly:<generated>@localhost:6379/0
